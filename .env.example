# vi: set ft=sh
GIT_PROJECT_ROOT=/srv/git
CGIT_CONFIG=/etc/cgit/cgitrc
GIT_ROOT=/srv/git
OUT_ROOT=/srv/releases
REPO_LIST=/etc/repos.txt
INTERVAL="900" # 15m, 1h; set "0" for run once
FETCH_TIMEOUT="300"
VERBOSE="1"
WRITE_SHA256="1"
KEEP_N="3"
RELEASES_KEEP_N="5"
INCLUDE_PRERELEASE="0"
ENABLE_ZIPBALL="0"
EXPORT_INSTALL_ASSETS="1"
SCAN_EXECUTABLES="1"
PRUNE_MISSING="0" # Set "1" to auto prune
MIRROR_LFS="0" # Set "1" if LFS is needed
ALL_PROXY=http://proxy.internal:8080
NO_PROXY="127.0.0.1,localhost,*.mirror.example.com"
#GITHUB_TOKEN="" # optional credential
GIT_ROOT=/srv/git
CGIT_BASE=https://mirror.exampele.com
KEEP_N=3
SUBSCRIPTION_URL=
PROXY_PORT=8080
REFRESH_INTERVAL=3h

# plugin store config
PLUGIN_STORE_DB_PATH=./plugins.db
PLUGIN_STORE_ARTIFACT_DIR=./artifacts
PLUGIN_STORE_IMAGE_DIR=./assets/images
PLUGIN_STORE_MIRROR_VERSION_COUNT=3
PLUGIN_STORE_MIRROR_REQUEST_INTERVAL=0.5
PLUGIN_STORE_ARTIFACT_STORAGE=local
PLUGIN_STORE_ARTIFACT_S3_BUCKET=
PLUGIN_STORE_ARTIFACT_S3_PREFIX=
PLUGIN_STORE_DOWNLOAD_PATH=./assets/plugins
PLUGIN_STORE_PUBLIC_BASE_URL=http://localhost:8000
